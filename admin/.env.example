# EXTRACLS — Admin Application Environment Template

# Local development (default — same backend as web)
VITE_BASE_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
VITE_BASE_URL_ADMIN=http://localhost:5000
VITE_IMAGE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000
VITE_SOCKET_PATH=/socket.io
VITE_SUPPORT_EMAIL=services.extracls@gmail.com
VITE_GOOGLE_CLIENT_ID=

# Production: replace localhost with your API host, e.g.
# VITE_BASE_URL=https://your-api-host
# VITE_API_BASE_URL=https://your-api-host
# VITE_BASE_URL_ADMIN=https://your-api-host
# VITE_IMAGE_URL=https://your-api-host
# VITE_SOCKET_URL=https://your-api-host